{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kavo",
  "version": "0.1.1",
  "identifier": "dev.kavo.app",
  "build": {
    "beforeDevCommand": "pnpm run dev:tauri",
    "devUrl": "http://localhost:21728",
    "beforeBuildCommand": "pnpm run build:tauri",
    "frontendDist": "../dist/public"
  },
  "app": {
    "windows": [
      {
        "title": "Kavo",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "theme": null
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Kavo — HTTP client",
    "longDescription": "Kavo composes, organises and sends HTTP requests, with collections, environments and a readable response viewer."
  }
}
