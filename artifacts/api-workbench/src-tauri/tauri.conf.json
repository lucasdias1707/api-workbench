{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Carom",
  "version": "0.5.0",
  "identifier": "dev.carom.client",
  "build": {
    "beforeDevCommand": "pnpm run dev:tauri",
    "devUrl": "http://localhost:21728",
    "beforeBuildCommand": "pnpm run build:tauri",
    "frontendDist": "../dist/public"
  },
  "app": {
    "windows": [
      {
        "title": "Carom",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "theme": null,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/lucasdias1707/carom-client-api/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhENjAyN0M4OTAzREVENwpSV1RYM2dPSmZBTFdDR0tpRGQvNmc5ME81bDl4YzRjakV5TnhRQ21CMmQxSFNuQ2RZaTBhWGNVZQo="
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Carom \u2014 HTTP client",
    "longDescription": "Carom composes, organises and sends HTTP requests, with collections, environments and a readable response viewer."
  }
}
