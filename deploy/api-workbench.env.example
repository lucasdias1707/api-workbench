# Copy to /etc/api-workbench.env, fill in, then lock it down:
#   sudo chown root:root /etc/api-workbench.env && sudo chmod 600 /etc/api-workbench.env
#
# Both the API server and Caddy read this file, so the secret never appears in a
# unit file or in the shell history.

# Let the forwarder reach private addresses: your VCN, other instances, the
# host's own services. Leave this out if you only ever call public APIs — the
# smaller the reach, the smaller the damage if the gate ever fails.
PROXY_ALLOW_PRIVATE_NETWORK=true

# Required whenever the line above is set in production. Generate with:
#   openssl rand -hex 32
# Caddy attaches it to every request it forwards; the browser never sees it, so
# reaching the server directly is not enough to use the forwarder.
PROXY_SHARED_SECRET=replace-with-openssl-rand-hex-32
